# Copy to ".env" in this folder, then restart "npm run dev".
# Vite only reads env files that live next to package.json (project root).
#
# For production builds (Vercel, Netlify, etc.), define the same variables
# in the host's environment before "vite build" runs — .env is not committed.
#
# Values for this project (public URL / ref). Publishable key: Supabase Dashboard
# → Project Settings → API → anon public, or Supabase MCP get_anon_key.

VITE_SUPABASE_URL=https://pnlocibettgyqyttegcu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=pnlocibettgyqyttegcu
